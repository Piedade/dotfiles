#!/bin/bash

# Pausa/retoma o swayidle (bloqueio de ecrã, dpms off e suspensão automática,
# ver swayidle-start.sh). O idle-notify do Wayland conta a inatividade real
# desde a última atividade, não desde que o processo é retomado — por isso
# um SIGSTOP/SIGCONT não pausa mesmo a contagem, só atrasa o processamento
# do evento: se já tivesse passado tempo suficiente de inatividade durante a
# pausa, o ecrã bloqueava logo ao retomar. Por isso aqui termina-se o
# swayidle por completo ao pausar, e relança-se do zero ao retomar, para que
# a contagem recomece nesse momento.

state_file="${XDG_RUNTIME_DIR:-/tmp}/swayidle-paused"

if [ -f "$state_file" ]; then
    rm -f "$state_file"
    setsid ~/.config/sway/scripts/swayidle-start.sh >/dev/null 2>&1 &
    disown
    notify-send "Idle" "▶ Bloqueio automático ativo."
else
    pid=$(pgrep -x swayidle)
    if [ -z "$pid" ]; then
        notify-send "Idle" "swayidle não está a correr."
        exit 1
    fi
    kill "$pid"
    touch "$state_file"
    notify-send "Idle" "⏸ Bloqueio automático pausado."
fi

pkill -SIGRTMIN+4 waybar 2>/dev/null
